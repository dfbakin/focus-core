*.pth

.DS_Store
/mlruns
app/models/
*.ts
SLOW_8x8_R50.pyth
demo_lecture.mp4
# run outputs stay out of git; DVC pointer files in outputs/ are kept
# (a bare `outputs/` rule makes DVC reject outputs/*.dvc as git-ignored)
outputs/*
!outputs/*.dvc
!outputs/.gitignore

# scene-disjoint dataset roots generated by scripts/review (manifests + videos symlink)
/data/grp*/
/data/p1_f*/
/data/p2_f*/

# research figures show students' faces (frame sheets, cluster overviews); keep them local
docs/research/figures/*.png
