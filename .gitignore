__pycache__/
*.py[cod]
*.egg-info/
.eggs/

.venv/
venv/
*.egg

# cached filtered manifests + analysis artifacts
data/**/data_labels/.cache/
docs/dataset_analysis.json
docs/dataset_analysis.csv

.vscode/

*.ckpt
